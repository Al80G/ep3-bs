<?php

$catid = $this->category->need('catid');

$this->setup(array(
    'title' => 'Championship-Administration',
    'panel' => 'centered-panel large-sized',
    'back' => array(
        'Category' => $this->url('backend/championship/category-edit', ['catid' => $catid]),
    ),
));

$participantLabels = $this->participantLabels;

$participantLabel = function ($pid) use ($participantLabels) {
    return $pid ? ($participantLabels[$pid] ?? '?') : '— bye —';
};

?>

<?= $this->partial('championship/partial/table-style.phtml') ?>

<div>
    <h1><?= $this->t('Bracket') ?>: <?= $this->escapeHtml($this->category->need('name')) ?></h1>

    <div class="separator-small"></div>

    <?php foreach ($this->groups as $group): ?>

        <h2><?= $this->escapeHtml($group->need('name')) ?></h2>

        <div class="separator-small"></div>

        <?php $standings = $this->standingsByGroup[$group->need('gid')]; ?>

        <?php if ($standings): ?>
            <table class="default-table championship-table">
                <tr>
                    <th><?= $this->t('Participant') ?></th>
                    <th><?= $this->t('Played') ?></th>
                    <th><?= $this->t('Wins') ?></th>
                    <th><?= $this->t('Losses') ?></th>
                    <th><?= $this->t('Sets') ?></th>
                    <th><?= $this->t('Diff') ?></th>
                </tr>

                <?php foreach ($standings as $row): ?>
                    <tr>
                        <td><?= $this->escapeHtml($participantLabel($row['pid'])) ?></td>
                        <td><?= $row['played'] ?></td>
                        <td><?= $row['wins'] ?></td>
                        <td><?= $row['losses'] ?></td>
                        <td><?= $row['sets_won'] ?>:<?= $row['sets_lost'] ?></td>
                        <td><?= $row['set_diff'] ?></td>
                    </tr>
                <?php endforeach; ?>
            </table>
        <?php else: ?>
            <p class="gray"><?= $this->t('No members in this group yet.') ?></p>
        <?php endif; ?>

        <div class="separator-small"></div>

        <?php $groupMatches = $this->groupMatchesByGroup[$group->need('gid')]; ?>

        <?php if ($groupMatches): ?>
            <table class="default-table championship-table">
                <tr>
                    <th><?= $this->t('Participant 1') ?></th>
                    <th><?= $this->t('Participant 2') ?></th>
                    <th><?= $this->t('Result') ?></th>
                    <th></th>
                </tr>

                <?php foreach ($groupMatches as $match): ?>
                    <tr>
                        <td><?= $this->escapeHtml($participantLabel($match->get('participant1_pid'))) ?></td>
                        <td><?= $this->escapeHtml($participantLabel($match->get('participant2_pid'))) ?></td>
                        <td>
                            <?php if ($match->isPlayed()): ?>
                                <b><?= $this->t(ucfirst($match->need('status'))) ?>, <?= $this->escapeHtml($participantLabel($match->get('winner_pid'))) ?> <?= $this->t('won') ?></b>
                            <?php else: ?>
                                <span class="gray"><?= $this->t('not yet played') ?></span>
                            <?php endif; ?>
                        </td>
                        <td>
                            <a href="<?= $this->url('backend/championship/match-edit', ['mid' => $match->need('mid')]) ?>" class="unlined gray">
                                <span class="symbolic symbolic-edit"><?= $this->t('Edit') ?></span>
                            </a>
                        </td>
                    </tr>
                <?php endforeach; ?>
            </table>
        <?php else: ?>
            <p class="gray"><?= $this->t('No matches yet.') ?></p>
        <?php endif; ?>

        <div class="separator separator-line"></div>

    <?php endforeach; ?>

    <h2><?= $this->t('Knock-out stage') ?></h2>

    <div class="separator-small"></div>

    <?php if (! $this->koGenerated): ?>

        <p><?= $this->t('The knock-out stage has not been generated yet.') ?></p>

    <?php else: ?>

        <?php
        $roundsByNumber = array();

        foreach ($this->koMatches as $match) {
            $roundsByNumber[$match->need('round_number')][] = $match;
        }

        ksort($roundsByNumber);
        ?>

        <div style="white-space: nowrap; overflow-x: auto;">
            <?php foreach ($roundsByNumber as $roundNumber => $matches): ?>
                <div style="display: inline-block; vertical-align: top; margin-right: 32px; min-width: 220px;">
                    <h3><?= $this->escapeHtml($matches[0]->need('round_name')) ?></h3>

                    <?php foreach ($matches as $match): ?>
                        <div class="default-table" style="margin-bottom: 12px; padding: 8px; border: 1px solid #CCC;">
                            <div><?= $this->escapeHtml($participantLabel($match->get('participant1_pid'))) ?></div>
                            <div><?= $this->escapeHtml($participantLabel($match->get('participant2_pid'))) ?></div>

                            <?php if ($match->isPlayed()): ?>
                                <div class="gray"><?= $this->t('Winner') ?>: <b><?= $this->escapeHtml($participantLabel($match->get('winner_pid'))) ?></b></div>
                            <?php endif; ?>

                            <div>
                                <a href="<?= $this->url('backend/championship/match-edit', ['mid' => $match->need('mid')]) ?>" class="unlined gray">
                                    <span class="symbolic symbolic-edit"><?= $this->t('Edit') ?></span>
                                </a>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
            <?php endforeach; ?>
        </div>

    <?php endif; ?>

    <div class="separator separator-line"></div>

    <form method="post" action="<?= $this->url('backend/championship/bracket', ['catid' => $catid]) ?>">
        <?php if ($this->koGenerated): ?>
            <input type="hidden" name="regenerate" value="1">
            <button type="submit" class="default-button" onclick="return confirm('<?= $this->t('This deletes the current (not yet played) knock-out stage and regenerates it from the current group standings. Continue?') ?>');">
                <span class="symbolic symbolic-reload"><?= $this->t('Regenerate bracket') ?></span>
            </button>
        <?php else: ?>
            <button type="submit" class="default-button">
                <span class="symbolic symbolic-plus"><?= $this->t('Generate bracket') ?></span>
            </button>
        <?php endif; ?>
    </form>
</div>
